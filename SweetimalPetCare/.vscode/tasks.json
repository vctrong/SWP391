{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Try build with Maven Wrapper",
			"type": "shell",
			"command": "./mvnw -v",
			"args": [],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Maven package (skip tests)",
			"type": "shell",
			"command": "mvn",
			"args": [
				"-q",
				"-DskipTests",
				"package"
			],
			"isBackground": false,
			"problemMatcher": [
				"$maven"
			],
			"group": "build"
		}
	]
}